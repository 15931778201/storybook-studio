{
  "name": "storybook-mvp-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/reader-web",
    "build": "npm run build -w packages/shared-types && npm run build -w apps/api && npm run build -w apps/reader-web",
    "test": "npm run test -w apps/api"
  }
}
